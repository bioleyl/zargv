{
  "name": "zargv",
  "version": "0.1.0",
  "description": "A Zod-first CLI framework where Zod schemas remain the single source of truth.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
