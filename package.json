  },
  "peerDependencies": {
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^3.1.0",
    "zod": "^3.24.0"
  }
}